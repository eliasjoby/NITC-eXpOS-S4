// Store user SP to UPTR in process table -> 13 th word
[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 13] = SP;

// Set SP to start of Kernel stack
SP = [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 11] * 512 - 1;

backup;

if ([SYSTEM_STATUS_TABLE + 5] != 0) then  //1 for swap out  2 for swap in
    if ([SYSTEM_STATUS_TABLE + 1] == SWAPPER_DAEMON) then 	//if process is swapper daemon
        R1 = [SYSTEM_STATUS_TABLE + 5];	//wtv the swap is 
        R2 = [SYSTEM_STATUS_TABLE + 1];	//pid
        call PAGER_MODULE;
    endif;
else
    if ([SYSTEM_STATUS_TABLE + 2] < MEM_LOW) then	 
        [SYSTEM_STATUS_TABLE + 5] = SWAP_OUT;	//setting the swap status cuz the proces is crossing some threshold
    else
        if ([SYSTEM_STATUS_TABLE + 4] > 0) then    	//swapped out process
            if ([SYSTEM_STATUS_TABLE + 2] > MEM_HIGH) then	
                [SYSTEM_STATUS_TABLE + 5] = SWAP_IN;
            else
                alias i R0;
                i = 0;
                while (i < MAX_PROC_NUM) do 	//if tick limit reached
                    if ([PROCESS_TABLE + i * 16 + 6] == 1 && [PROCESS_TABLE + i * 16 + 0] > MAX_TICK) then
                        [SYSTEM_STATUS_TABLE + 5] = SWAP_IN;
                        break;
                    endif;
                    i = i + 1;
                endwhile;
            endif;
        endif;
    endif;
endif;
//set everything to ready and running
[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 4] = READY; 

// increment tick values
alias i R0;
i = 0; 
while (i < MAX_PROC_NUM) do
    [PROCESS_TABLE + i * 16] = [PROCESS_TABLE + i * 16] + 1; 
    i = i + 1;
endwhile;

call MOD_5;

restore;

SP = [PROCESS_TABLE + 16 * [SYSTEM_STATUS_TABLE + 1] + 13];
[PROCESS_TABLE + 16 * [SYSTEM_STATUS_TABLE + 1] + 12] = 0;
[PROCESS_TABLE + 16 * [SYSTEM_STATUS_TABLE + 1] + 9] = 0;

ireturn;

////loadi(mem,disc)
loadi(69,11); 	//idle code
loadi(70,12);
//boot module 7	
loadi(54,67);
loadi(55,68);
//init stack
SP=82*512-1;
call BOOT_MODULE;
PTBR=PAGE_TABLE_BASE;  //as PID of idle process is 0

//Library
[PTBR+0] = 63;
[PTBR+1] = "0100";
[PTBR+2] = 64;
[PTBR+3] = "0100";
//Heap
[PTBR+4] = -1;
[PTBR+5] = "0000";
[PTBR+6] = -1;
[PTBR+7] = "0000";

//Code
[PTBR+8] = 69;	//only 1 code page loaded
[PTBR+9] = "0100";
[PTBR+10] = -1;
[PTBR+11] = "0000";
[PTBR+12] = -1;
[PTBR+13] = "0000";
[PTBR+14] = -1;
[PTBR+15] = "0000";

//Stack
[PTBR+16] = 70;
[PTBR+17] = "0110";
[PTBR+18] = -1;
[PTBR+19] = "0000";
[70*512] = [69*512+1];
SP=8*512;

[PROCESS_TABLE+15] = 10;	//ptlr
[PROCESS_TABLE+14] = PTBR;	//ptbr
[PROCESS_TABLE+13]=8*512;	//usersp
[PROCESS_TABLE+12]=0;	//kptr
[PROCESS_TABLE+11] = 76; //user stack page
[PROCESS_TABLE+1] = 0;	//pid
[PROCESS_TABLE+4] = RUNNING;	//state
[SYSTEM_STATUS_TABLE + 1] = 0;	//pid
//Library code shared alreadey
[MEMORY_FREE_LIST+63]=4;
[MEMORY_FREE_LIST+64]=4;
ireturn;

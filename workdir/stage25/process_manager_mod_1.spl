if(R1==1) then //get free pcb entry
	R2=0;
	while([PROCESS_TABLE+R2*16+4]!=TERMINATED && R2<16) do //inactive entry is terminated process
		R2=R2+1;
	endwhile;
	R0=-1; //assuming no file found
	if(R2<16) then //if valid pcb entry
		[PROCESS_TABLE+16*R2+4]= ALLOCATED; //updating status to alloc not created, cuz it has to get values assigned  
		[PROCESS_TABLE+16*R2+1]=R2; //index of the proces
		[PROCESS_TABLE+16*R2+14]=PAGE_TABLE_BASE+20*R2;	//ptbr 
		[PROCESS_TABLE+16*R2+15]=10; //ptlr
		R0=R2; //return index of pcb
	endif;
	return;
endif;

//free user area page R2 = pid
if(R1==2) then 
R3=[PROCESS_TABLE+16*R2+11];	//user area page swapped in 
alias PrntPerProcess R5;	//loop throught all per process resource entry to find file or sema
PrntPerProcess=[PROCESS_TABLE+16*[SYSTEM_STATUS_TABLE+1]+11]*512+496;
R6=0;
while(R6<8) do
    if([PrntPerProcess+2*R6]==1) then	//semaphore
        multipush(R1,R2,R3,R4,R5,R6);
        R1=RELEASE_SEMAPHORE;
        R2=[PrntPerProcess+2*R6+1];
        R3=[SYSTEM_STATUS_TABLE+1];
        call MOD_0;	//resource manager
        multipop(R1,R2,R3,R4,R5,R6);
    endif;
    if([PrntPerProcess+2*R6]==FILE) then	//file
        multipush(R1,R2,R3,R4,R5,R6);
        R1=CLOSE;
        R2=[PrntPerProcess+2*R6+1];
        call MOD_3;	//file manager
        multipop(R1,R2,R3,R4,R5,R6);
    endif;
    R6=R6+2;
endwhile;
multipush(R1,R2,R3);
R2=R3;
R1=2;	//release page in memoery manager
call MOD_2;
multipop(R1,R2,R3);
return;
endif;

//Exit process
if(R1==3) then
multipush(R1,R2,R3);
R1=4;	//free page table 
call MOD_1;
multipop(R1,R2,R3);
multipush(R1,R2,R3);
R1=2;	//free user area page
call MOD_1;
multipop(R1,R2,R3);

//if mode is not 9
if([PROCESS_TABLE+R2*16+9]!=9) then
	R3=0;
	while(R3<16) do //process waiting for pid to terminate
		if([PROCESS_TABLE+16*R3+4]==WAIT_PROCESS && [PROCESS_TABLE+16*R3+5]==R2) then
			[PROCESS_TABLE+16*R3+4]=READY;
		endif;
		if([PROCESS_TABLE+16*R3+2]==R2) then
			[PROCESS_TABLE+16*R3+2]=-1;
		endif;
	R3=R3+1;
	endwhile;
endif;
[PROCESS_TABLE+16*R2+4]=TERMINATED;
return;
endif;

if(R1==4) then
	R3=0;
	while(R3<10) do
	multipush(R1,R2,R3);
	R1=2;	//release page for the page table entry
	R2=[PAGE_TABLE_BASE+20*R2+2*R3];
	if(R2>0) then
		call MOD_2;
	endif;
	multipop(R1,R2,R3);
	[PAGE_TABLE_BASE+20*R2+2*R3]=-1;	//set them invalid
	[PAGE_TABLE_BASE+20*R2+2*R3+1]="0000";
	R3=R3+1;
	endwhile;

	//if valid entry and is stack or heap, release block on those
	multipush(R1,R2,R3);
	R1=4;
	R3=[SYSTEM_STATUS_TABLE+1];
	R2=[DISK_MAP_TABLE+10*R3+3];
	call MOD_2;
	multipop(R1,R2,R3);
	multipush(R1,R2,R3);
	R1=4;
	R3=[SYSTEM_STATUS_TABLE+1];
	R2=[DISK_MAP_TABLE+10*R3+3];
	call MOD_2;
	multipop(R1,R2,R3);
	multipush(R1,R2,R3);
	R1=4;
	R3=[SYSTEM_STATUS_TABLE+1];
	R2=[DISK_MAP_TABLE+10*R3+3];
	call MOD_2;
	multipop(R1,R2,R3);
	multipush(R1,R2,R3);
	R1=4;
	R3=[SYSTEM_STATUS_TABLE+1];
	R2=[DISK_MAP_TABLE+10*R3+3];
	call MOD_2;
	multipop(R1,R2,R3);
	//entries set to -1
	R3=0;
	while(R3<10) do
	[DISK_MAP_TABLE+10*R2+R3]=-1;
	R3=R3+1;
	endwhile;

return;
endif;

if(R1==KILL_ALL) then
    R1=0;
    //acquirng inode for all files
    while(R1<MAX_FILE_NUM) do
        R2=INODE_TABLE+16*R1;
        if([R2+1]!=-1) then	//valid entry 
            multipush(R1,R2);
            R2=R1;
            R1=ACQUIRE_INODE;
            R3=[SYSTEM_STATUS_TABLE+1];
            call MOD_0;
            multipop(R1,R2);
        endif;
        R1=R1+1;
    endwhile;

    R1=2;	//pid 0 is idle pid 1 is init 
    R2=[SYSTEM_STATUS_TABLE+1];
    while(R1<MAX_PROC_NUM) do
        if(R1!=R2 && [PROCESS_TABLE+R1*16+4]!=TERMINATED) then //cant terminate the process that called kill all
            multipush(R1,R2);
            R1=EXIT_PROCESS;
            R2=R2;
            call MOD_1;
            multipop(R1,R2);
        endif;
        R1=R1+1;
    endwhile;

    R1=0;
    while(R1<MAX_FILE_NUM) do
        R2=INODE_TABLE+16*R1;
        if([R2+1]!=-1) then
            multipush(R1,R2);
            R2=R1;
            R1=RELEASE_INODE;
            R3=[SYSTEM_STATUS_TABLE+1];
            call MOD_0;
            multipop(R1,R2);
        endif;
        R1=R1+1;
    endwhile;

    return;
endif;


            

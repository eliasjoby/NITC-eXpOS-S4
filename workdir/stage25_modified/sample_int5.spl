// ================= ENTER KERNEL =================

// Save user stack pointer
alias userSP R1;
userSP = SP;

// Get syscall number from user stack
alias syscall R2;
syscall =
    [[PTBR + 2 * ((userSP - 5) / 512)] * 512
        + ((userSP - 5) % 512)];


// Locate current process table entry
alias process R3;
process =
    PROCESS_TABLE + 16 * [SYSTEM_STATUS_TABLE + 1];

// Save USER SP
[process + 13] = SP;

// Switch to kernel stack
SP = [process + 11] * 512;



// ======================================================
// ================= OPEN SYSTEM CALL ====================
// ======================================================

if (syscall == INT_OPEN) then

    // Set MODE_FLAG = OPEN
    [process + 9] = R2;



    // ================= GET ARGUMENT =================

    alias FileName R4;

    FileName =
        [[PTBR + 2 * ((userSP - 4) / 512)] * 512
            + ((userSP - 4) % 512)];



    // ================= FIND FREE FD =================

    alias PerProcess R5;

    PerProcess =
        [process + 11] * 512
            + RESOURCE_TABLE_OFFSET;

    R6 = 0;

    while (R6 < 8) do

        if ([PerProcess + 2 * R6] == -1) then
            break;
        endif;

        R6 = R6 + 1;

    endwhile;



    // No free descriptor

    if (R6 >= 8) then

        [[PTBR + 2 * ((userSP - 1) / 512)] * 512
            + ((userSP - 1) % 512)] = -3;

    else

        // Call Resource Manager OPEN

        multipush(R1, R3, R5, R6);

        R2 = FileName;
        R1 = OPEN;

        call MOD_3;

        multipop(R1, R3, R5, R6);



        // Error from OPEN

        if (R0 < 0) then

            [[PTBR + 2 * ((userSP - 1) / 512)] * 512
                + ((userSP - 1) % 512)] = R0;

        else

            // Store file descriptor mapping

            R7 = PerProcess + 2 * R6;

            [R7]     = FILE;
            [R7 + 1] = R0;

            // Return descriptor

            [[PTBR + 2 * ((userSP - 1) / 512)] * 512
                + ((userSP - 1) % 512)] = R6;

        endif;

    endif;



    // Exit syscall

    [process + 9] = 0;

    SP = userSP;

    ireturn;

endif;



// ======================================================
// ================= CLOSE SYSTEM CALL ===================
// ======================================================

if (syscall == INT_CLOSE) then

    // Set MODE_FLAG = CLOSE
    [process + 9] = syscall;



    // ================= GET ARGUMENT =================

    alias Filedesc R2;

    Filedesc =
        [[PTBR + 2 * ((userSP - 4) / 512)] * 512
            + ((userSP - 4) % 512)];



    // Validate descriptor range

    if (R2 > 7 || R2 < 0) then

        [[PTBR + 2 * ((userSP - 1) / 512)] * 512
            + ((userSP - 1) % 512)] = -1;

    else

        // Locate per-process entry

        alias PerProcessEntry R4;

        PerProcessEntry =
            [process + 11] * 512
                + RESOURCE_TABLE_OFFSET
                + 2 * Filedesc;



        // Ensure descriptor refers to file

        if ([PerProcessEntry] != FILE) then

            [[PTBR + 2 * ((userSP - 1) / 512)] * 512
                + ((userSP - 1) % 512)] = -1;

        else

            // Call Resource Manager CLOSE

            multipush(R1, R3, R4);

            R1 = CLOSE;
            R2 = [PerProcessEntry + 1];

            call MOD_3;

            multipop(R1, R3, R4);



            // Clear entry

            [PerProcessEntry] = -1;

            [[PTBR + 2 * ((userSP - 1) / 512)] * 512
                + ((userSP - 1) % 512)] = 0;

        endif;

    endif;



    // Exit syscall

    [process + 9] = 0;

    SP = userSP;

    ireturn;

endif;



// ======================================================
// ================= SEEK SYSTEM CALL ====================
// ======================================================

if (syscall == INT_SEEK) then

    // Set MODE_FLAG = 6 (SEEK)
    [process + 9] = syscall;



    // ================= GET ARGUMENTS =================

    alias Filedesc R4;

    Filedesc =
        [[PTBR + 2 * ((userSP - 4) / 512)] * 512
            + ((userSP - 4) % 512)];

    alias offset R2;

    offset =
        [[PTBR + 2 * ((userSP - 3) / 512)] * 512
            + ((userSP - 3) % 512)];


alias PerProcess R5;

    PerProcess =
        [process + 11] * 512
            + RESOURCE_TABLE_OFFSET;

    R6 = 0;

    while (R6 < 8) do

        if ([PerProcess + 2 * R6] == -1) then
            break;
        endif;

        R6 = R6 + 1;

    endwhile;



    // No free descriptor

    if (R6 >= 8) then

        [[PTBR + 2 * ((userSP - 1) / 512)] * 512
            + ((userSP - 1) % 512)] = -3;

    else

        // Call Resource Manager OPEN

        multipush(R1, R3, R5, R6);

        R2 = FileName;
        R1 = OPEN;

        call MOD_3;

        multipop(R1, R3, R5, R6);



        // Error from OPEN

        if (R0 < 0) then

            [[PTBR + 2 * ((userSP - 1) / 512)] * 512
                + ((userSP - 1) % 512)] = R0;

        else

            // Store file descriptor mapping

            R7 = PerProcess + 2 * R6;

            [R7]     = FILE;
            [R7 + 1] = R0;

            // Return descriptor

            [[PTBR + 2 * ((userSP - 1) / 512)] * 512
                + ((userSP - 1) % 512)] = R6;

        endif;

    endif;



    // ================= EXIT SEEK =================

    [process + 9] = 0;

    SP = userSP;

    ireturn;

endif;

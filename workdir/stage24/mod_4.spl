//DEVICE MANAGER module

alias fxnNum R1;
alias currPID R2;

// Disk Store
if( fxnNum == DISK_STORE) then
  alias pageno R3;
  alias blockno R4;
  //acquire disk
  multipush(R1,R2,R3,R4);
  R1 = ACQUIRE_DISK;
  call RESOURCE_MANAGER;
  multipop(R1,R2,R3,R4);

  store(pageno, blockno);
  //set disk status params
  //load store bit
  [DISK_STATUS_TABLE + 1] = 1;
  [DISK_STATUS_TABLE + 2] = pageno;
  [DISK_STATUS_TABLE + 3] = blockno;

  [PROCESS_TABLE + currPID * 16 + 4]=WAIT_DISK;
  multipush(R1,R2,R3,R4);

  call SCHEDULER;

  multipop(R1,R2,R3,R4);
  return;
endif;

// DISK_LOAD
if(fxnNum==2)then 
    //print "Disk_Access";
    alias pgNo R3;
    alias blkNo R4;

    //call acquire_disk
    multipush(R0,R1,R2,R3,R4,R5);
    R1=3;
    R2=currPID;
    call MOD_0;
    multipop(R0,R1,R2,R3,R4,R5);

    //reset load/store bit, set pgNo,blkNo in DST 
    [DISK_STATUS_TABLE+1]=0;
    [DISK_STATUS_TABLE+2]=pgNo;
    [DISK_STATUS_TABLE+3]=blkNo;

    //load disk blk to mem
    load(pgNo,blkNo);

    //set status to WAIT_DISK
    [PROCESS_TABLE + 16*currPID + 4]=WAIT_DISK;

    //call scheduler
    multipush(R0,R1,R2,R3,R4,R5);
    call MOD_5;
    multipop(R0,R1,R2,R3,R4,R5);

    return;
endif;

//Terminal Write
if(fxnNum==3)then //
    //------------------------calling acquire terminal

    multipush(R0,R1,R2,R3,R5);
    fxnNum=8;
    currPID=[SYSTEM_STATUS_TABLE+1];

    call MOD_0;

    multipop(R0,R1,R2,R3,R5);
    print R3; 

    //-----------------------calling release terminal

    multipush(R0,R1,R2,R3,R5);
    fxnNum=9;
    currPID=[SYSTEM_STATUS_TABLE+1];

    call MOD_0;

    multipop(R0,R1,R2,R3,R5);
    return;

endif;

//Terminal read
if(fxnNum==4)then

    //acquire terminal
   multipush(R0,R1,R2,R3,R5);
   fxnNum=8;
   currPID=[SYSTEM_STATUS_TABLE+1];
   call MOD_0;

   multipop(R0,R1,R2,R3,R5);

    //---------------------------------------------------------

    //issue IN and block the terminal
   read;
   [PROCESS_TABLE + 16*[SYSTEM_STATUS_TABLE+1] +4]=WAIT_TERMINAL;

    //call scheduler
    multipush(R0,R1,R2,R3,R5);
    call MOD_5;

    //--------------------------------------------------------

    //returns after console interrupt...process table updated with input buffer
    multipop(R0,R1,R2,R3,R5);

    //store content of input buffer to wordAddress...as given in R3;
    alias pAddr R6; //of address to store in --- R3 has lAddr of var
    PTBR=[PROCESS_TABLE + 16*[SYSTEM_STATUS_TABLE+1] + 14];
    pAddr=[PTBR+2*((R3)/512)]*512 + ((R3)%512);

    [pAddr]=[PROCESS_TABLE + 16*[SYSTEM_STATUS_TABLE+1] + 8];
    return;
endif;

R0=-1;
return;

